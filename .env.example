# Codex CLI uses your existing ChatGPT login: run `codex login` once.
# No OpenAI API key is required for this local reviewer.
REVIEW_EXECUTION=codex
# Optional; otherwise follows the model in ~/.codex/config.toml or CLI default.
# CODEX_REVIEW_MODEL=
CODEX_REVIEW_TIMEOUT_SECONDS=600
# REVIEW_EXECUTION=manual restores the teammate handoff workflow.

# macOS only: if codex doctor reports UnknownIssuer, use existing system roots.
# CODEX_CA_CERTIFICATE=/etc/ssl/cert.pem
