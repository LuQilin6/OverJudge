# Python environment and generated files
.venv/
.python-runtime/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Local secrets and machine files
.env
.env.*
!.env.example
.DS_Store

# Source recordings and generated artifacts
inputs/videos/*
!inputs/videos/.gitkeep
work/clips/*
!work/clips/.gitkeep
# Round outputs are versioned; transient locks and temporary writes are not.
outputs/**/*.lock
outputs/**/*.tmp
# Keep generated video clips local along with input recordings.
outputs/**/*.mp4
outputs/**/*.mov
outputs/**/*.mkv
config/run.json
config/manifest.json
